# Local only — gitignored. Pytest loads this file when it exists (see conftest.py).
# Adjust hosts/ports for your machine. See aerospike.env.example for full notes.

# Regular Aerospike server
export AEROSPIKE_HOST=127.0.0.1:3010

export AEROSPIKE_USE_SERVICES_ALTERNATE=true

# Multi-node cluster auth (uncomment when testing against 8_1_1_1_cluster)
export AEROSPIKE_AUTH_MODE=INTERNAL
export AEROSPIKE_AUTH_USER=admin
export AEROSPIKE_AUTH_PASSWORD=admin

export AEROSPIKE_HOST_SEC=localhost:3101

# Version-gated tests use the single AEROSPIKE_HOST + capability gates
# (supports_*), not per-version host vars. Point AEROSPIKE_HOST at an
# 8.1.2+/8.1.3 build to run them; CI covers the version spread via a matrix.

export AEROSPIKE_HOST_TLS=localhost:3103
export AEROSPIKE_TLS_NAME=tls1
export AEROSPIKE_TLS_CA_FILE=/Users/pbrackin/tools/aerolab/CA/cacert.pem
export AEROSPIKE_TLS_CLIENT_CERT_FILE=/Users/pbrackin/tools/aerolab/CA/cert.pem
export AEROSPIKE_TLS_CLIENT_KEY_FILE=/Users/pbrackin/tools/aerolab/CA/key.pem

# true only if this host is Aerospike Enterprise
export AEROSPIKE_ENTERPRISE=true

# 8.1.3 SC cluster (~/tmp/sc-cluster-8.1.3). The previous seed was the aerolab
# 8.1.1.1 cluster, which predates extended error detail (>= 8.1.3) -- so the SC
# suites ran against an older build than the AP suites.
export AEROSPIKE_HOST_SC=127.0.0.1:3120
export AEROSPIKE_SC_NAMESPACE=test_sc

# Logging — set to enable client logging across all layers (core, PAC, PFC)
export AEROSPIKE_LOG_LEVEL=WARNING
# export AEROSPIKE_LOG_FILE=/tmp/aerospike.log
export AEROSPIKE_HOST_TLS_LOGIN=localhost:3106
